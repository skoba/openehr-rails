<?xml version="1.0" encoding="UTF-8"?>
<!--
  Reduced, synthetic regression fixture for the FieldExtractor terminology-scope fix
  (issue #25). Lineage, as measured against the actual design record -- not the real
  CKM archetypes "laboratory_test_result"/"laboratory_test_analyte" (no evidence
  either exists in CKM), not a reduction of Anlage's real LabResultReport.opt (see
  openehr-ruby#36 for that file's existence; this fixture is not derived from it),
  and not sourced from issue #25's own body (it contains no at-code examples or
  line citations to draw from). The at-codes, archetype IDs, and label text below
  were specified from scratch in docs/design/fix-terminology-scope-plan.md section
  4 (the TDD plan) -- modeled structurally, not by content, on the real
  embedded-archetype at-code collision confirmed in openehr-ruby's own (CKM-derived)
  test fixture spec/lib/openehr/opt_parser/eReferral.opt -- and then implemented as
  XML per that spec: an outer OBSERVATION.laboratory_test_result entry with its own
  at0001 term ("検査状態" -- test status), embedding a CLUSTER.laboratory_test_analyte
  via C_ARCHETYPE_ROOT whose own terminology defines both a colliding at0001
  ("分析結果" -- analysis result) and a CLUSTER-only at0024 ("分析名" -- analysis
  name) that the outer entry has no definition for at all.
-->
<template xmlns="http://schemas.openehr.org/v1" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <language>
    <terminology_id><value>ISO_639-1</value></terminology_id>
    <code_string>ja</code_string>
  </language>
  <description>
    <original_author id="date">2026-08-22</original_author>
    <lifecycle_state>unmanaged</lifecycle_state>
    <details>
      <language>
        <terminology_id><value>ISO_639-1</value></terminology_id>
        <code_string>ja</code_string>
      </language>
      <purpose>Terminology-scope regression fixture</purpose>
    </details>
  </description>
  <template_id><value>lab_result_report_reduced</value></template_id>
  <concept>lab_result_report_reduced</concept>
  <definition>
    <rm_type_name>COMPOSITION</rm_type_name>
    <occurrences><lower>1</lower><upper>1</upper></occurrences>
    <node_id>at0000</node_id>
    <attributes xsi:type="C_MULTIPLE_ATTRIBUTE">
      <rm_attribute_name>content</rm_attribute_name>
      <children xsi:type="C_ARCHETYPE_ROOT">
        <rm_type_name>OBSERVATION</rm_type_name>
        <occurrences><lower>0</lower><upper>1</upper></occurrences>
        <node_id>at0000</node_id>
        <attributes xsi:type="C_SINGLE_ATTRIBUTE">
          <rm_attribute_name>data</rm_attribute_name>
          <children xsi:type="C_COMPLEX_OBJECT">
            <rm_type_name>HISTORY</rm_type_name>
            <occurrences><lower>1</lower><upper>1</upper></occurrences>
            <node_id>at0002</node_id>
            <attributes xsi:type="C_MULTIPLE_ATTRIBUTE">
              <rm_attribute_name>events</rm_attribute_name>
              <children xsi:type="C_COMPLEX_OBJECT">
                <rm_type_name>EVENT</rm_type_name>
                <occurrences><lower>0</lower><upper>1</upper></occurrences>
                <node_id>at0003</node_id>
                <attributes xsi:type="C_SINGLE_ATTRIBUTE">
                  <rm_attribute_name>data</rm_attribute_name>
                  <children xsi:type="C_COMPLEX_OBJECT">
                    <rm_type_name>ITEM_TREE</rm_type_name>
                    <occurrences><lower>1</lower><upper>1</upper></occurrences>
                    <node_id>at0004</node_id>
                    <attributes xsi:type="C_MULTIPLE_ATTRIBUTE">
                      <rm_attribute_name>items</rm_attribute_name>
                      <children xsi:type="C_COMPLEX_OBJECT">
                        <rm_type_name>ELEMENT</rm_type_name>
                        <occurrences><lower>0</lower><upper>1</upper></occurrences>
                        <node_id>at0001</node_id>
                        <attributes xsi:type="C_SINGLE_ATTRIBUTE">
                          <rm_attribute_name>value</rm_attribute_name>
                          <children xsi:type="C_COMPLEX_OBJECT">
                            <rm_type_name>DV_TEXT</rm_type_name>
                            <occurrences><lower>1</lower><upper>1</upper></occurrences>
                            <node_id></node_id>
                          </children>
                        </attributes>
                      </children>
                      <children xsi:type="C_ARCHETYPE_ROOT">
                        <rm_type_name>CLUSTER</rm_type_name>
                        <occurrences><lower>0</lower><upper>1</upper></occurrences>
                        <node_id>at0010</node_id>
                        <attributes xsi:type="C_MULTIPLE_ATTRIBUTE">
                          <rm_attribute_name>items</rm_attribute_name>
                          <children xsi:type="C_COMPLEX_OBJECT">
                            <rm_type_name>ELEMENT</rm_type_name>
                            <occurrences><lower>0</lower><upper>1</upper></occurrences>
                            <node_id>at0001</node_id>
                            <attributes xsi:type="C_SINGLE_ATTRIBUTE">
                              <rm_attribute_name>value</rm_attribute_name>
                              <children xsi:type="C_COMPLEX_OBJECT">
                                <rm_type_name>DV_TEXT</rm_type_name>
                                <occurrences><lower>1</lower><upper>1</upper></occurrences>
                                <node_id></node_id>
                              </children>
                            </attributes>
                          </children>
                          <children xsi:type="C_COMPLEX_OBJECT">
                            <rm_type_name>ELEMENT</rm_type_name>
                            <occurrences><lower>0</lower><upper>1</upper></occurrences>
                            <node_id>at0024</node_id>
                            <attributes xsi:type="C_SINGLE_ATTRIBUTE">
                              <rm_attribute_name>value</rm_attribute_name>
                              <children xsi:type="C_COMPLEX_OBJECT">
                                <rm_type_name>DV_TEXT</rm_type_name>
                                <occurrences><lower>1</lower><upper>1</upper></occurrences>
                                <node_id></node_id>
                              </children>
                            </attributes>
                          </children>
                        </attributes>
                        <archetype_id><value>openEHR-EHR-CLUSTER.laboratory_test_analyte.v1</value></archetype_id>
                        <term_definitions code="at0001">
                          <items id="text">分析結果</items>
                          <items id="description">分析の結果。</items>
                        </term_definitions>
                        <term_definitions code="at0024">
                          <items id="text">分析名</items>
                          <items id="description">分析項目の名称。</items>
                        </term_definitions>
                      </children>
                    </attributes>
                  </children>
                </attributes>
              </children>
            </attributes>
          </children>
        </attributes>
        <archetype_id><value>openEHR-EHR-OBSERVATION.laboratory_test_result.v1</value></archetype_id>
        <term_definitions code="at0001">
          <items id="text">検査状態</items>
          <items id="description">検査の状態。</items>
        </term_definitions>
      </children>
    </attributes>
    <archetype_id><value>openEHR-EHR-COMPOSITION.report-result.v1</value></archetype_id>
    <template_id><value>lab_result_report_reduced</value></template_id>
    <term_definitions code="at0000">
      <items id="text">検査結果報告</items>
      <items id="description">検査結果の報告。</items>
    </term_definitions>
  </definition>
</template>
